# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and update values with your environment details:
#   cp .env.example .env
# ==============================================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Security - Set a strong, randomly-generated secret key in production
# Example to generate a key in Python: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change_this_to_a_secure_random_hex_key_for_production

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dacs

# Flask-SocketIO Configuration
# Set to specific domains in production (e.g., https://yourdomain.com)
SOCKETIO_CORS_ALLOWED_ORIGINS=*

